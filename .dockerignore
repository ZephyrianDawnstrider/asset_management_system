# Deny everything, then allow only application source needed by the web image.
**
!manage.py
!requirements.txt
!asset_management/
!asset_management/*.py
!assets/
!assets/*.py
!assets/migrations/
!assets/migrations/*.py
!assets/templates/
!assets/templates/**
!assets/static/
!assets/static/**
!build.sh
!start.sh

# Re-deny local/generated content and data even if future allow rules broaden.
**/__pycache__/
**/*.py[cod]
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.dump
**/*.sql
**/*.env
**/.env*
**/*secret*
**/*credential*
**/*password*
assets/tests.py
assets/test_*.py
assets/*_test.py
assets/management/
assets/management/**
work/
data/
.git/
.venv/
venv/
staticfiles/
logs/
